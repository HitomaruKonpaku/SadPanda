{
  "manifest_version": 3,
  "name": "Sad Panda",
  "version": "6.0",
  "description": "Easy access to ExHentai",
  "permissions": ["cookies", "tabs"],
  "host_permissions": [
    "*://e-hentai.org/*",
    "*://*.e-hentai.org/*",
    "*://exhentai.org/*"
  ],
  "icons": {
    "16": "ico/16.png",
    "32": "ico/32.png",
    "48": "ico/48.png",
    "64": "ico/64.png",
    "128": "ico/128.png"
  },
  "background": {
    "service_worker": "src/js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://forums.e-hentai.org/*"],
      "js": ["src/js/jquery.min.js", "src/js/return.js"],
      "css": []
    },
    {
      "matches": ["*://exhentai.org/", "*://exhentai.org/#"],
      "js": ["src/js/jquery.min.js", "src/js/login.js"],
      "css": []
    },
    {
      "matches": ["*://exhentai.org/*"],
      "js": ["src/js/logout.js"],
      "css": []
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/html/login.html"],
      "matches": [
        "*://e-hentai.org/*",
        "*://*.e-hentai.org/*",
        "*://exhentai.org/*"
      ]
    }
  ],
  "homepage_url": "https://github.com/HitomaruKonpaku/SadPanda",
  "incognito": "split"
}
